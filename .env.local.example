# Pocket Trainer — environment configuration
# All AI calls are made server-side. Never expose these values to the client.

# The AI Coach works out of the box with a built-in offline knowledge engine.
# To enable live LLM responses, provide an Anthropic API key below.
ANTHROPIC_API_KEY=

# Optional model override (defaults to a current Claude model)
PT_AI_MODEL=

# Public app name (safe to expose to the client)
NEXT_PUBLIC_APP_NAME=Pocket Trainer
