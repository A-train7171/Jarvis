# Frontend (Vite) — only VITE_-prefixed vars are exposed to the app bundle.
# Base URL for the AI backend. Leave blank in dev to use the Vite proxy (/api).
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Backend secrets live in server/.env and are NEVER prefixed with VITE_ and
# NEVER bundled into the app. See server/.env.example (added in Milestone 2).
# ANTHROPIC_API_KEY=sk-ant-...
