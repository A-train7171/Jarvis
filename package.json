{
  "name": "setlocate-go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "icons": "node scripts/icons.mjs",
    "build:mobile": "BUILD_TARGET=mobile next build",
    "cap:sync": "pnpm build:mobile && cap sync",
    "cap:add:ios": "pnpm build:mobile && cap add ios && cap sync ios",
    "cap:add:android": "pnpm build:mobile && cap add android && cap sync android",
    "ios": "pnpm cap:sync && cap open ios",
    "android": "pnpm cap:sync && cap open android",
    "ios:run": "pnpm cap:sync && cap run ios",
    "android:run": "pnpm cap:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@tanstack/react-query": "^5.100.10",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "mapbox-gl": "^3.23.1",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
