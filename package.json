{
  "name": "pocket-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your Coach. In Your Pocket. — mobile-first fitness & nutrition coach.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
