# Anthropic API key — server-side ONLY. Never prefix with VITE_, never ship to the app.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for all AI features. The build spec calls for Sonnet; override if desired.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server port (the Vite dev proxy targets 8787).
PORT=8787

# Comma-separated allowed origins for CORS (dev defaults shown).
# Add your deployed landing-site origin here so the waitlist form can POST.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Where landing-page waitlist signups are appended (JSONL).
WAITLIST_FILE=data/waitlist.jsonl
